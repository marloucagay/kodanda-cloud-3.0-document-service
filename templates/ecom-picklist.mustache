<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    html, body {
      height: 100%;
      display: flex; 
      flex-direction: column; 
      justify-content: space-between; 
      font-family: Arial, Helvetica, sans-serif;
      color: #111;
    }
    table { width:100%; border-collapse:collapse; }
    th, td { border: 1px solid #111; padding: 3px; font-size: 12px; height: 20px; }
    tr { page-break-inside: avoid; }
  </style>
</head>
<body>
    <div>
      <table>
        <tbody>
            <tr>
                <td colspan="4" style="font-weight: 700; font-size: 18px; padding: 6px; position: relative; text-align: center; overflow: visible; height: 40px;">
                    {{#logoSrcDataUri}}
                    <img src="{{{logoSrcDataUri}}}" alt="logo"
                         style="position: absolute; left: -10px; top: -14px; height: 40px; z-index: -1; background: #fff; height: 80px;" />
                    {{/logoSrcDataUri}}
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #D9D9D9; z-index: -2;"></div>
                    PICKING LIST
                </td>
            </tr>
            <tr>
                <td colspan="4" style="height: 10px;"></td>
            </tr>
            <tr>
                <td align="right" style="font-weight: 700; width: 20%;">Order Date:</td>
                <td align="left">{{orderDate}}</td>
                <td align="right" style="font-weight: 700; width: 20%;">SI #</td>
                <td align="left" style="font-weight: 700;">{{siNumber}}</td>
            </tr>
            <tr>
                <td align="right" style="font-weight: 700; width: 20%;">Consignee Name:</td>
                <td align="left">{{consigneeName}}</td>
                <td align="right" style="font-weight: 700; width: 20%;">ORDER #:</td>
                <td align="left" style="font-weight: 700;">{{orderNumber}}</td>
            </tr>
            <tr>
                <td align="right" style="font-weight: 700; width: 20%;">Delivery Address:</td>
                <td align="left">{{deliveryAddress}}</td>
                <td align="right" style="font-weight: 700; width: 20%;">Date/Time Processed:</td>
                <td align="left">{{dateTimeProcessed}}</td>
            </tr>
            <tr>
                <td colspan="4" style="border-bottom: none; height: 10px;"></td>
            </tr>
        </tbody>
      </table>
      <table>
        <thead>
            <tr style="background: #D9D9D9;">
                <th align="center">LINE #</th>
                <th align="center">CODE</th>
                <th align="center">DESCRIPTION</th>
                <th align="center">QTY</th>
                <th align="center">EXPIRY DATE</th>
                <th align="center">CLASSIFICATION</th>
                <th align="center">LOCATION</th>
            </tr>
        </thead>
        <tbody>
            {{#pickingListsItems}}
            <tr>
                <td align="center" style="border-right: 1px dotted #111; border-top: 1px dotted #111; border-bottom: 1px dotted #111; width: 7%;">{{rowNo}}</td>
                <td align="center" style="border: 1px dotted #111;">{{itemCode}}</td>
                <td align="center" style="border: 1px dotted #111;">{{itemName}}</td>
                <td align="center" style="border: 1px dotted #111;">{{quantity}}</td>
                <td align="center" style="border: 1px dotted #111;">{{expirationDate}}</td>
                <td align="center" style="border: 1px dotted #111;">{{condition}}</td>
                <td align="center" style="border-left: 1px dotted #111; border-top: 1px dotted #111; border-bottom: 1px dotted #111;">{{location}}</td>
            </tr>
            {{/pickingListsItems}}
            <tr>
                <td colspan="3" align="right" style="font-weight: 700;">TOTAL:</td>
                <td align="center" style="border-right: none;">{{totalQuantity}}</td>
                <td style="border-left: none; border-right: none;"></td>
                <td style="border-left: none; border-right: none;"></td>
                <td style="border-left: none;"></td>
            </tr>
            <tr>
                <td colspan="3" style="font-weight: 700;">PACKED BY:</td>
                <td colspan="4" style="font-weight: 700;">TYPE OF BOX:</td>
            </tr>
        </tbody>
      </table>
    </div>
    
</body>
</html>