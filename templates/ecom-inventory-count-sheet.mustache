<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        color: #111;
        margin: 0 2mm;
      }

      h3 {
        font-size: 13px;
        margin: 14px 0 6px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
      }
      th,
      td {
        border: 1px solid #434242;
        padding: 5px 7px;
        font-size: 12px;
        word-wrap: break-word;
        overflow-wrap: anywhere;
      }
      th {
        text-align: center;
        padding: 5px 3px;
      }
      thead {
        display: table-header-group;
      }
      tr {
        page-break-inside: avoid;
      }

      table.info {
        margin-bottom: 15px;
      }

      table.info td {
        border: none;
        padding: 3px 7px;
      }

      table.info td.field {
        font-weight: 700;
        background: none;
      }

      table.count td {
        height: 9mm;
      }
      .c {
        text-align: center;
      }
      .r {
        text-align: right;
      }
      .total td {
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <table class="info">
      <colgroup>
        <col style="width: 18%" />
        <col style="width: 32%" />
        <col style="width: 18%" />
        <col style="width: 32%" />
      </colgroup>
      <tbody>
        <tr>
          <td class="field">MDLI Product Code</td>
          <td>{{ mDLIProductCode }}</td>
          <td class="field">Client Product Code</td>
          <td>{{ clientProductCode }}</td>
        </tr>
        <tr>
          <td class="field">Item Description</td>
          <td colspan="3">{{ itemDescription }}</td>
        </tr>
        <tr>
          <td class="field">UOM</td>
          <td>{{ uOM }}</td>
          <td class="field">Product Group</td>
          <td>{{ productGroup }}</td>
        </tr>
        <tr>
          <td class="field">Storage Type</td>
          <td colspan="3">{{ storageType }}</td>
        </tr>
      </tbody>
    </table>

    <table class="count">
      <colgroup>
        <col style="width: 5%" />
        <col style="width: 45%" />
        <col style="width: 10%" />
        <col style="width: 10%" />
        <col style="width: 10%" />
        <col style="width: 10%" />
        <col style="width: 10%" />
      </colgroup>
      <thead>
        <tr>
          <th>No.</th>
          <th>Batch/Lot No.</th>
          <th>Available Qty</th>
          <th>Allocated Qty</th>
          <th>Total Qty</th>
          <th>Actual Qty</th>
          <th>Variance</th>
        </tr>
      </thead>
      <tbody>
        {{#countItems}}
        <tr>
          <td class="c">{{ lineNo }}</td>
          <td>{{ batchLotNo }}</td>
          <td class="c">{{ availableQuantity }}</td>
          <td class="c">{{ allocatedQuantity }}</td>
          <td class="c">{{ totalQuantity }}</td>
          <td></td>
          <td></td>
        </tr>
        {{/countItems}}
        <tr class="total">
          <td colspan="4" class="r">TOTAL</td>
          <td class="c">{{ totalSystemQty }}</td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
