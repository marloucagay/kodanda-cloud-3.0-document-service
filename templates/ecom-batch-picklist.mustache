<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      html,
      body {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        font-family: Arial, Helvetica, sans-serif;
        color: #111;
      }

      table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
      }

      th,
      td {
        border-top: 1px solid #111;
        border-bottom: 1px solid #111;
        padding: 3px;
        font-size: 12px;
        height: 27px;
        overflow-wrap: anywhere;
      }

      th:not(:last-child),
      td:not(:last-child) {
        border-right: 1px solid #111;
      }

      th:first-child,
      td:first-child {
        border-left: 1px solid #111;
      }

      th:last-child,
      td:last-child {
        border-right: 1px solid #111;
      }

      tr.plain-row td {
        border: none;
      }

      tr {
        page-break-inside: avoid;
        padding: 0;
      }

      .no-border {
        border: none;
      }

      .spacer-row {
        height: 10px;
      }

      .label {
        font-weight: 700;
        text-align: right;
      }

      .value {
        text-align: left;
      }

      .value-bold {
        text-align: left;
        font-weight: 700;
      }

      .header-cell {
        text-align: center;
      }

      .nowrap {
        white-space: nowrap;
      }

      .center-text {
        text-align: center;
      }

      .bold {
        font-weight: 700;
      }

      .item-name {
        text-align: center;
      }

      .item-cell {
        padding: 2px;
        border-top: 1px dotted #111;
        border-bottom: 1px dotted #111;
      }

      .item-cell:not(:last-child) {
        border-right: 1px dotted #111;
      }

      .total-label {
        text-align: right;
        font-weight: 700;
        padding-right: 8px;
      }

      .total-value {
        font-weight: 700;
        padding-left: 8px;
        border-top: 1px solid #111;
      }

      .sign-cell {
        vertical-align: top;
        height: 40px;
        font-weight: 700;
      }

      .sign-cell-bordered {
        border-right: 1px solid #111;
      }

      .sign-times {
        display: flex;
        gap: 16px;
        margin-top: 8px;
        font-weight: 400;
      }

      .sign-times span {
        flex: 1;
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <div>
      <table>
        <colgroup>
          <col style="width: 30%" />
          <col style="width: 10%" />
          <col style="width: 25%" />
          <col style="width: 8%" />
          <col style="width: 9%" />
          <col style="width: 9%" />
          <col style="width: 9%" />
        </colgroup>
        <thead>
          <tr class="plain-row">
            <td class="label">SO</td>
            <td class="value" colspan="2"></td>
            <td class="label">TOTAL: {{ totalQuantity }}</td>
            <td class="value-bold"></td>
            <td class="value-bold">{{ printDate }}</td>
            <td class="value-bold">{{ printTime }}</td>
          </tr>
          <tr class="header-row">
            <th class="header-cell">BATCHING</th>
            <th class="header-cell">Code</th>
            <th class="header-cell">S_ItemName</th>
            <th class="header-cell">QTY</th>
            <th class="header-cell nowrap">Expiration</th>
            <th class="header-cell">Staging</th>
            <th class="header-cell">Location</th>
          </tr>
        </thead>
        <tbody>
          {{#pickingListsItems}}
          <tr>
            <td class="item-cell center-text bold">{{ rowNo }}</td>
            <td class="item-cell center-text">{{ itemCode }}</td>
            <td class="item-cell item-name">{{ itemName }}</td>
            <td class="item-cell center-text">{{ quantity }}</td>
            <td class="item-cell center-text">{{ expirationDate }}</td>
            <td class="item-cell center-text">{{ condition }}</td>
            <td class="item-cell center-text">{{ location }}</td>
          </tr>
          {{/pickingListsItems}}
          <tr>
            <td colspan="7" class="spacer-row no-border"></td>
          </tr>
          <tr>
            <td colspan="2" class="sign-cell">
              PICKED BY:
              <div class="sign-times">
                <span>Time start:</span>
                <span>Time end:</span>
              </div>
            </td>
            <td colspan="5" class="sign-cell sign-cell-bordered">
              CHECKED BY:
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </body>
</html>
